@startuml
title Архитектура системы через год (C4: Диаграмма контейнеров)

actor "Сотрудник" as Пользователь
actor "Администратор" as Админ

node "Головной офис" as ГоловнойОфис {
    component "BI Портал" as BI_Портал
    component "Портал самообслуживания" as Портал_Самообслуживания
}

node "DWH/Data Lakehouse" as DWH {
    component "Новое DWH\n(Cloud-based)" as Новое_DWH
    component "Data Lakehouse\n(Delta Lake, Iceberg)" as Data_Lakehouse
    component "Витрина данных" as Витрина_Данных
}

node "Интеграционный слой" as ИнтеграционныйСлой {
    component "Apache Kafka\n(основной потоковый брокер)" as Kafka
    component "Apache Camel\n(для легаси)" as Camel
    component "ETL/ELT платформа\n(Airflow, dbt)" as ETL
}

node "Внутренние сервисы" as ВнутренниеСервисы {
    component "Финансовые данные" as Финансовые_Данные
    component "Управление клиниками" as Управление_Клиниками
    component "Персонал и инвентаризация" as Персонал_Инвентаризация
}

node "Медицинский домен" as МедицинскийДомен {
    component "ИИ Сервисы" as ИИ_Сервисы
    component "Медицинская система" as Медицинская_Система
}

node "Финтех домен" as ФинтехДомен {
    component "Финтех сервисы" as Финтех_Сервисы
    component "Кредитный модуль" as Кредитный_Модуль
}

' Связи
Пользователь --> Портал_Самообслуживания : Использует
Админ --> BI_Портал : Управляет аналитикой
Портал_Самообслуживания --> Витрина_Данных : Запрашивает данные
BI_Портал --> Витрина_Данных : Использует данные для отчётов
Витрина_Данных --> Новое_DWH : Данные из хранилища
Новое_DWH --> Data_Lakehouse : Хранение и обработка данных
Data_Lakehouse --> Kafka : Потоковые события
Kafka --> Медицинская_Система : Данные о пациентах
Kafka --> Финтех_Сервисы : Финансовые данные
Kafka --> ИИ_Сервисы : Передача медицинских данных
ИИ_Сервисы --> Медицинская_Система : Анализ данных и рекомендации
ИИ_Сервисы --> Data_Lakehouse : Обогащение данных
ETL --> Data_Lakehouse : Загружает данные
Camel --> Новое_DWH : Легаси-данные
Camel --> Kafka : Передача данных
ВнутренниеСервисы --> Camel : Интеграция с шиной
Медицинская_Система --> Camel : Интеграция медицинских данных
